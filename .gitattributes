# Text files are stored and checked out with LF, as .editorconfig writes them;
# git detects binaries itself.
*                     text=auto eol=lf

# Hunk headers name the enclosing function or heading.
*.go                  text diff=golang
*.md                  text diff=markdown
*.sh                  text diff=bash

# Patch context lines for blank source lines are a single space, which is
# not a whitespace error here.
*.patch               text -whitespace

# Collapsed in pull request diffs, and left out of the language statistics.
go.sum                linguist-generated
third_party/go-nfs/** linguist-vendored
