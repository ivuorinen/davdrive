root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{*.go,go.mod,go.sum}]
indent_style = tab

[*.md]
max_line_length = 120
trim_trailing_whitespace = false

# Diffs reproduce Go source lines, tabs and all.
[*.patch]
indent_style = unset
trim_trailing_whitespace = unset

# Licence texts stay verbatim.
[LICENSE]
indent_size = unset
indent_style = unset

# Generated by the nitpicker findings tool, which writes each paragraph on one line.
[docs/audit/findings/**]
max_line_length = off
